{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "booking",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
    },
  ],
}
