    {
      "name": "Bookings",
      "item": [
        {
          "name": "CreateBooking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{url}}/v1/bookings",
            "description": "Optional quantity must be an integer from 1\u20134 (omission defaults to 1); non-RACING categories accept only 1 or omission. The server resolves category ownership/acronym. RACING assigns distinct machines continuously free for the full interval, ordered by sort order/name/ID, even for quantity 1. Confirmed and unexpired pending bookings block overlaps; adjacent intervals, cancelled bookings and expired holds do not. Insufficient capacity returns 409 before writes. One booking has N reservation rows and one unchanged upfront payment flow. Other categories retain the temporary assignment bypass. The response still temporarily returns payment_url: null. Concurrency protection and atomicity remain deferred.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"business_id\": \"{{business_id}}\",\n  \"customer_id\": \"{{customer_id}}\",\n  \"from\": \"{{bookingFrom}}\",\n  \"duration\": 60,\n  \"room_category_id\": \"{{room_category_id}}\",\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set(\"booking_id\", data.booking_id);",
                  "  pm.collectionVariables.set(\"payment_url\", data.payment_url || \"\");",
                  "  pm.collectionVariables.set(\"order_id\", \"\");",
                  "  pm.collectionVariables.set(\"reference_id\", \"\");",
                  "  if (data.payment_url) {",
                  "    const match = data.payment_url.match(/\\/demo\\/payment\\/([^/?#]+)/);",
                  "    if (match) pm.collectionVariables.set(\"order_id\", decodeURIComponent(match[1]));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "QueryBooking",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{url}}/v1/bookings/{{booking_id}}",
            "description": "Returns booking or null. Reservations include assigned room_id/room_name and requested room_category_id/room_category_name/room_category_acronym, interval and exact duration in minutes.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
