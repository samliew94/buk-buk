{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".svelte-kit/output/**",
        ".svelte-kit/cloudflare/**"
      ],
      "env": [
        "PUBLIC_*"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "persistent": true,
      "cache": false,
      "env": [
        "PUBLIC_*"
      ]
    },
    "types": {
      "dependsOn": [
        "^types"
      ],
      "env": [
        "PUBLIC_*"
      ]
    }
  }
}
